# ============================================================
# SOICT 2026 - LLM-Augmented Log Anomaly Detection & RCA
# .gitignore
# ============================================================

# --- DATA: EXCLUDE ALL RAW AND PROCESSED DATA DIRECTORIES ---
data/raw/*
data/processed/*
data/Thang6.rar
data/*.rar
data/*.zip
data/*.log
data/*.tar
data/*.gz

# Keep only gitkeep placeholders
!data/raw/.gitkeep
!data/raw/README.md
!data/processed/.gitkeep
!data/processed/README.md

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
env/
.env

# --- PyTorch / Model Checkpoints ---
*.pth
*.pt
*.ckpt
*.bin
*.safetensors
models/
checkpoints/

# --- LaTeX Build Artifacts ---
paper/*.aux
paper/*.log
paper/*.out
paper/*.toc
paper/*.lof
paper/*.lot
paper/*.fls
paper/*.fdb_latexmk
paper/*.synctex.gz
paper/*.blg
paper/*.bbl
paper/*.bcf
paper/*.run.xml
!paper/soict2026.pdf

# --- IDE & OS ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini
